# Servicio systemd de ejemplo para mantener el túnel activo en una Raspberry Pi.
#
# 1. Copia este archivo a /etc/systemd/system/flota-tunnel.service
# 2. Ajusta User, WorkingDirectory y el comando del túnel (cloudflared o ssh).
# 3. sudo systemctl daemon-reload
#    sudo systemctl enable --now flota-tunnel
#    journalctl -u flota-tunnel -f
#
[Unit]
Description=Flota Táctica - túnel público de la beta
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/flota-tactica-v2
Environment=LOCAL_PORT=8080
# Opción A: Cloudflare quick tunnel (URL aleatoria en cada reinicio)
ExecStart=/usr/bin/cloudflared tunnel --url http://localhost:8080 --no-autoupdate
# Opción B: localhost.run por SSH (comenta la línea anterior y usa esta)
# ExecStart=/usr/bin/ssh -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -R 80:localhost:8080 nokey@localhost.run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
