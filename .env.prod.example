# Copia este archivo a .env.prod y ajusta los valores en el servidor.
# Uso: docker compose --env-file .env.prod -f docker/compose.prod.yml up -d

# Dominio público (Caddy gestiona TLS automáticamente). Para pruebas locales: localhost
DOMAIN=flota.example.com

# Origen permitido para CORS. En producción, el dominio público.
CORS_ORIGIN=https://flota.example.com

# Base de datos
POSTGRES_USER=flota
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flota

# Autenticación
JWT_SECRET=change-me-with-a-long-random-string
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Imágenes publicadas por el CD (GHCR)
SERVER_IMAGE=ghcr.io/4r4web/flota-server:latest
WEB_IMAGE=ghcr.io/4r4web/flota-web:latest
