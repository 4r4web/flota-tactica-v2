# Servidor
PORT=3000
NODE_ENV=development

# Base de datos
DATABASE_URL=postgres://flota:flota@localhost:5432/flota

# Redis
REDIS_URL=redis://localhost:6379

# Autenticación (valores de ejemplo para desarrollo)
JWT_SECRET=change-me-in-development
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Seguridad
CORS_ORIGIN=*
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
BODY_LIMIT=16384
