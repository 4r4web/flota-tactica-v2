{$DOMAIN:localhost} {
  encode gzip

  @api path /api/*
  handle @api {
    reverse_proxy server:3000
  }

  @ws path /ws
  handle @ws {
    reverse_proxy server:3000
  }

  @health path /health
  handle @health {
    reverse_proxy server:3000
  }

  @metrics path /metrics
  handle @metrics {
    respond 403
  }

  handle {
    reverse_proxy web:80
  }
}
